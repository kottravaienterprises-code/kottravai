{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|webp|svg|ico|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**|config.json",
      "memory": 512,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/analytics/send-daily-report",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/track/cart-recovery",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/sitemap_products_1.xml",
      "destination": "/api/sitemap_products_1.xml"
    },
    {
      "source": "/sitemap_pages_1.xml",
      "destination": "/api/sitemap_pages_1.xml"
    },
    {
      "source": "/sitemap_collections_1.xml",
      "destination": "/api/sitemap_collections_1.xml"
    },
    {
      "source": "/sitemap_blogs_1.xml",
      "destination": "/api/sitemap_blogs_1.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|assets|robots.txt|sitemap.xml|sitemap_.*\\.xml|favicon.png|logo.png|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}